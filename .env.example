# Flask / App
APP_ENV=development
HOST=127.0.0.1
PORT=5000
DEBUG=false
SECRET_KEY=dev-secret
# Production should set SECRET_KEY to a non-default value with at least 32 characters.
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://crm.example.com

# Default credentials (dev)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DISPATCHER_USERNAME=dispatcher
DISPATCHER_PASSWORD=disp123
# MASTER_PASSWORD=dev-only-temp (deprecated; used only when explicitly requested on master creation)

# SLA defaults (minutes)
# SLA_RESPONSE_MINUTES=30
# SLA_COMPLETION_MINUTES=120

# Optional SMTP for completion emails
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=change-me
